<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Text?>

<VBox alignment="CENTER" spacing="20" xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Text text="ToWhere" style="-fx-font-size: 36px; -fx-font-weight: bold;"/>

    <Text text="Log in om je reizen, favorieten en instellingen te bewaren" style="-fx-font-size: 14px; -fx-fill: #555;"/>

    <VBox spacing="15" prefWidth="300">
        <TextField fx:id="usernameField" promptText="E-mailadres of gebruikersnaam" prefHeight="40"/>
        <PasswordField fx:id="passwordField" promptText="Wachtwoord" prefHeight="40"/>

        <Button text="Inloggen" onAction="#handleLogin" prefWidth="300" prefHeight="40" style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;"/>

        <HBox alignment="CENTER" spacing="10">
            <Text text="of" style="-fx-fill: #888;"/>
            <Hyperlink text="Nieuw account aanmaken" onAction="#goToRegister"/>
        </HBox>
    </VBox>
</VBox>