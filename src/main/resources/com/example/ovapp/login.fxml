<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" spacing="15"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.LoginController">
    <padding>
        <Insets top="30" right="30" bottom="30" left="30"/>
    </padding>

    <Label text="Inloggen" style="-fx-font-size: 28px; -fx-font-weight: bold;"/>

    <TextField fx:id="usernameField" promptText="Gebruikersnaam" prefWidth="250"/>
    <PasswordField fx:id="passwordField" promptText="Wachtwoord" prefWidth="250"/>

    <Button text="Login" onAction="#handleLogin" prefWidth="120"/>

    <Label fx:id="messageLabel" text="" style="-fx-text-fill: red;"/>
</VBox>