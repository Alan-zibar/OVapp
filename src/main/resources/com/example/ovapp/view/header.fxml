<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER_LEFT"
      prefHeight="110"
      spacing="20"
      style="-fx-border-color: transparent transparent #333 transparent; -fx-border-width: 0 0 2 0; -fx-padding: 25 45 25 45;"
      xmlns="http://javafx.com/javafx/17.0.12"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.HeaderController">

    <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
        <image>
            <Image url="@/com/example/ovapp/images/ToWhere.png"/>
        </image>
    </ImageView>

    <Label text="ToWhere" style="-fx-font-size: 32px; -fx-font-weight: bold;" />

    <Region HBox.hgrow="ALWAYS" />

    <HBox alignment="CENTER" spacing="8">
        <Label text="🕒" style="-fx-font-size: 24px;" />
        <Label fx:id="currentTimeTextLabel" text="Huidige tijd:" style="-fx-font-size: 15px;" />
        <Label fx:id="currentTimeLabel" text="--:--:--" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    </HBox>

    <Region prefWidth="20" />

    <HBox alignment="CENTER" spacing="8">
        <Label text="🌐" style="-fx-font-size: 28px;" />
        <MenuButton fx:id="languageMenuButton" text="NL"
                    style="-fx-background-color: white; -fx-border-color: #555; -fx-border-width: 1.5; -fx-font-size: 16px; -fx-padding: 5 12 5 12; -fx-border-radius: 5; -fx-background-radius: 5;">
            <items>
                <MenuItem text="Nederlands" onAction="#setDutchLanguage" />
                <MenuItem text="English" onAction="#setEnglishLanguage" />
            </items>
        </MenuButton>
    </HBox>

    <Region prefWidth="15" />

    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="loginTopButton" text="Inloggen" onAction="#goToLogin"
                prefWidth="145" prefHeight="42"
                style="-fx-background-color: white; -fx-border-color: #555; -fx-border-width: 1.5; -fx-font-size: 16px;">
            <graphic>
                <Label text="👤" style="-fx-font-size: 21px;" />
            </graphic>
        </Button>
        <Button fx:id="logoutTopButton" text="Uitloggen" onAction="#handleLogout"
                prefWidth="145" prefHeight="42" visible="false" managed="false"
                style="-fx-background-color: white; -fx-border-color: #555; -fx-border-width: 1.5; -fx-font-size: 16px;">
            <graphic>
                <Label text="↪" style="-fx-font-size: 21px;" />
            </graphic>
        </Button>
    </HBox>
</HBox>