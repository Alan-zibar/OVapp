<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox alignment="CENTER_LEFT"
      prefHeight="110"
      spacing="20"
      style="-fx-border-color: transparent transparent #333 transparent;
             -fx-border-width: 0 0 2 0;
             -fx-padding: 25 45 25 45;"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="controller.HeaderController">

    <ImageView fitHeight="50" fitWidth="50" preserveRatio="true">
        <image>
            <Image url="@/com/example/ovapp/images/ToWhere.png"/>
        </image>
    </ImageView>

    <Label text="ToWhere"
           style="-fx-font-size: 32px; -fx-font-weight: bold;" />

    <Region HBox.hgrow="ALWAYS"/>

    <HBox alignment="CENTER" spacing="8">
        <Label text="🕒" style="-fx-font-size: 24px;" />
        <Label fx:id="currentTimeTextLabel" text="Huidige tijd:" style="-fx-font-size: 15px;" />
        <Label fx:id="currentTimeLabel" text="--:--:--" style="-fx-font-size: 18px; -fx-font-weight: bold;" />
    </HBox>

    <Region prefWidth="5"/>
    <HBox alignment="CENTER" spacing="-0">
        <Label text="🌐" style="-fx-font-size: 22px;" />

        <MenuButton fx:id="languageMenuButton"
                    text="NL"
                    minWidth="74" prefWidth="74" maxWidth="74"
                    style="-fx-background-color: transparent;
                       -fx-font-size: 20px;
                       -fx-padding: 0 0 0 2;">
            <items>
                <MenuItem text="Nederlands" onAction="#setDutchLanguage" />
                <MenuItem text="English" onAction="#setEnglishLanguage" />
            </items>
        </MenuButton>
    </HBox>

    <Region prefWidth="8"/>

    <HBox alignment="CENTER" spacing="12">
        <Button fx:id="loginTopButton"
                text="Inloggen"
                onAction="#goToLogin"
                minWidth="150"
                prefWidth="150"
                minHeight="44"
                prefHeight="44"
                styleClass="top-header-button">
            <graphic>
                <Label text="👤" style="-fx-font-size: 20px;" />
            </graphic>
        </Button>

        <Button fx:id="logoutTopButton"
                text="Uitloggen"
                onAction="#handleLogout"
                minWidth="160"
                prefWidth="160"
                minHeight="44"
                prefHeight="44"
                visible="false"
                managed="false"
                styleClass="top-header-button">
            <graphic>
                <Label text="↪" style="-fx-font-size: 20px;" />
            </graphic>
        </Button>
    </HBox>
</HBox>
