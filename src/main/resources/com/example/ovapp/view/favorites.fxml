<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.FavoritesController"
      spacing="26"
      style="-fx-background-color: white; -fx-padding: 35 0 0 55;">

    <VBox alignment="TOP_RIGHT" spacing="15">
        <Button fx:id="backButton"
                onAction="#backToHome"
                style="-fx-background-color: white;
       -fx-border-color: #555555;
       -fx-border-width: 1.3;
       -fx-border-radius: 10;
       -fx-background-radius: 10;
       -fx-padding: 12 35;
       -fx-font-size: 16px;
       -fx-font-weight: normal;
       -fx-text-fill: black;
       -fx-cursor: hand;" />

        <Button fx:id="clearFavoritesButton"
                onAction="#clearAllFavorites"
                style="-fx-background-color: white;
       -fx-border-color: #555555;
       -fx-border-width: 1.3;
       -fx-border-radius: 10;
       -fx-background-radius: 10;
       -fx-padding: 12 35;
       -fx-font-size: 16px;
       -fx-font-weight: normal;
       -fx-text-fill: black;
       -fx-cursor: hand;" />
    </VBox>

    <Label fx:id="titleLabel"
           style="-fx-font-size: 28px; -fx-font-weight: bold;" />

    <HBox fx:id="loginMessageBox"
          alignment="CENTER"
          visible="false"
          managed="false"
          prefWidth="850"
          style="-fx-padding: 80 0 0 0;">

        <Label fx:id="loginMessageLabel"
               style="-fx-font-size: 16px;
                  -fx-font-weight: bold;" />
    </HBox>

    <ScrollPane fx:id="favoritesScrollPane"
                fitToWidth="true"
                hbarPolicy="NEVER"
                vbarPolicy="AS_NEEDED"
                prefWidth="850"
                prefHeight="520">

        <content>
            <VBox fx:id="favoritesContainer"
                  spacing="22"
                  alignment="TOP_CENTER"
                  minHeight="500"
                  prefWidth="820"
                  style="-fx-padding: 20 0 40 0;
                     -fx-background-color: transparent;" />
        </content>
    </ScrollPane>

</VBox>