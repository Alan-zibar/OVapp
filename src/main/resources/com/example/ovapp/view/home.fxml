<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="controller.HomeController"
            prefWidth="1100"
            prefHeight="700">

    <!-- TOP BALK -->
    <top>
        <HBox spacing="15" alignment="CENTER_LEFT"
              style="-fx-background-color: #f5f5f5; -fx-padding: 10 20; -fx-border-color: #ddd; -fx-border-width: 0 0 1 0;">
            <Label text="ToWhere" style="-fx-font-size: 32px; -fx-font-weight: bold;"/>

            <Region HBox.hgrow="ALWAYS"/>

            <HBox alignment="CENTER" spacing="8">
                <Label text="Huidige tijd:" style="-fx-font-size: 15px;"/>
                <Label fx:id="currentTimeLabel"
                       text="--:--:--"
                       style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
            </HBox>

            <Label text="NL" style="-fx-font-size: 16px;"/>

            <Button text="Inloggen"
                    onAction="#goToLogin"
                    prefWidth="145"
                    prefHeight="42"
                    style="-fx-background-color: #0078D7; -fx-text-fill: white; -fx-font-weight: bold;"/>
        </HBox>
    </top>

    <!-- LINKER MENU -->
    <left>
        <VBox spacing="16"
              prefWidth="260"
              style="-fx-padding: 45 20 30 30; -fx-border-color: transparent #999 transparent transparent; -fx-border-width: 0 1.5 0 0;">
            <Button text="Home"
                    onAction="#goToHome"
                    prefWidth="190"
                    prefHeight="42"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-font-size: 16px;"/>

            <Button text="Reis plannen"
                    onAction="#goToPlanTrip"
                    prefWidth="190"
                    prefHeight="42"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-font-size: 16px;"/>

            <Button text="Favorieten"
                    onAction="#goToFavorites"
                    prefWidth="190"
                    prefHeight="42"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-font-size: 16px;"/>

            <Button text="Geschiedenis"
                    onAction="#goToHistory"
                    prefWidth="190"
                    prefHeight="42"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-font-size: 16px;"/>

            <Button text="Instellingen"
                    onAction="#goToSettings"
                    prefWidth="190"
                    prefHeight="42"
                    alignment="CENTER_LEFT"
                    style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
        </VBox>
    </left>

    <!-- CENTRUM (REIS PLANNEN) -->
    <center>
        <VBox spacing="30" alignment="TOP_CENTER"
              style="-fx-padding: 30;">
            <Label text="Plan je reis"
                   style="-fx-font-size: 36px; -fx-font-weight: bold;"/>

            <VBox spacing="25"
                  prefWidth="900"
                  maxWidth="900"
                  style="-fx-border-color: #777; -fx-border-width: 1.5; -fx-padding: 35; -fx-background-color: white;">

                <!-- Van / Naar / Wissel -->
                <HBox spacing="40" alignment="CENTER">
                    <!-- VAN -->
                    <VBox spacing="14" alignment="CENTER">
                        <Label text="Van" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <HBox spacing="10"
                              prefWidth="370"
                              prefHeight="80"
                              style="-fx-border-color: #b5b5b5; -fx-border-width: 1; -fx-background-color: linear-gradient(to bottom, #eeeeee, #dddddd); -fx-padding: 0 14;">
                            <ComboBox fx:id="fromComboBox"
                                      promptText="Kies vertrekstation"
                                      prefWidth="300"
                                      style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
                        </HBox>
                    </VBox>

                    <!-- WISSEL KNOP -->
                    <Button text="Wissel"
                            onAction="#swapStations"
                            prefWidth="80"
                            prefHeight="55"
                            style="-fx-font-size: 16px; -fx-background-color: white; -fx-border-color: #777; -fx-border-width: 1.5;">
                        <HBox.margin>
                            <Insets top="45" right="0" bottom="0" left="0"/>
                        </HBox.margin>
                    </Button>

                    <!-- NAAR -->
                    <VBox spacing="14" alignment="CENTER">
                        <Label text="Naar" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
                        <HBox spacing="10"
                              prefWidth="370"
                              prefHeight="80"
                              style="-fx-border-color: #b5b5b5; -fx-border-width: 1; -fx-background-color: linear-gradient(to bottom, #eeeeee, #dddddd); -fx-padding: 0 14;">
                            <ComboBox fx:id="toComboBox"
                                      promptText="Kies aankomststation"
                                      prefWidth="300"
                                      style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
                        </HBox>
                    </VBox>
                </HBox>

                <!-- DATUM EN TIJD (vereenvoudigd) -->
                <VBox spacing="10">
                    <Label text="Datum en tijd" style="-fx-font-size: 16px; -fx-font-weight: bold;"/>
                    <DatePicker fx:id="datePicker" prefWidth="200"/>
                </VBox>

                <!-- ZOEK KNOP -->
                <HBox alignment="CENTER">
                    <Button text="Zoek reis"
                            onAction="#searchTrip"
                            prefWidth="215"
                            prefHeight="55"
                            style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-background-color: white; -fx-border-color: #777;"/>
                </HBox>

                <!-- RESULTAAT -->
                <Label fx:id="messageLabel" text="" style="-fx-text-fill: red; -fx-wrap-text: true;"/>
            </VBox>
        </VBox>
    </center>
</BorderPane>