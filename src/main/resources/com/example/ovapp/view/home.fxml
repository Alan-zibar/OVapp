<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.shape.*?>

<VBox fillWidth="false"
      spacing="15"
      style="-fx-padding: 30 0 0 45;"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="controller.HomeController">

    <Label fx:id="planTitleLabel"
           style="-fx-font-size: 30px; -fx-font-weight: bold;"
           text="Plan je reis"/>

    <VBox maxWidth="900"
          prefHeight="390"
          prefWidth="900"
          spacing="25"
          style="-fx-border-color: #777;
                 -fx-border-width: 1.5;
                 -fx-padding: 35;
                 -fx-background-color: white;">

        <HBox alignment="CENTER" spacing="40">
            <VBox alignment="CENTER" spacing="14">
                <Label fx:id="fromTitleLabel"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"
                       text="Van"/>

                <HBox alignment="CENTER_LEFT"
                      prefHeight="80"
                      prefWidth="370"
                      spacing="14"
                      style="-fx-border-color: #b5b5b5;
                             -fx-border-width: 1;
                             -fx-background-color: linear-gradient(to bottom, #eeeeee, #dddddd);
                             -fx-padding: 0 14 0 14;">

                    <SVGPath
                            content="M12 2 C8.1 2 5 5.1 5 9 c0 5.25 7 13 7 13 s7-7.75 7-13 c0-3.9-3.1-7-7-7 z M12 11.5 c-1.4 0-2.5-1.1-2.5-2.5 s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5 z"
                            style="-fx-fill: transparent;
                                   -fx-stroke: #333333;
                                   -fx-stroke-width: 1.8;
                                   -fx-scale-x: 1.2;
                                   -fx-scale-y: 1.2;"/>

                    <ComboBox fx:id="fromComboBox"
                              prefHeight="70"
                              prefWidth="300"
                              promptText="Kies vertrekstation"
                              editable="true"
                              style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
                </HBox>
            </VBox>

            <Button onAction="#swapStations"
                    prefHeight="55"
                    prefWidth="60"
                    style="-fx-font-size: 26px;
                           -fx-font-family: 'Arial';
                           -fx-background-color: white;
                           -fx-border-color: #777;
                           -fx-border-width: 1.5;"
                    text="⇄">
                <HBox.margin>
                    <Insets top="45"/>
                </HBox.margin>
            </Button>

            <VBox alignment="CENTER" spacing="14">
                <Label fx:id="toTitleLabel"
                       style="-fx-font-size: 24px; -fx-font-weight: bold;"
                       text="Naar"/>

                <HBox alignment="CENTER_LEFT"
                      prefHeight="80"
                      prefWidth="400"
                      spacing="14"
                      style="-fx-border-color: #b5b5b5;
                             -fx-border-width: 1;
                             -fx-background-color: linear-gradient(to bottom, #eeeeee, #dddddd);
                             -fx-padding: 0 14 0 14;">

                    <SVGPath
                            content="M12 2 C8.1 2 5 5.1 5 9 c0 5.25 7 13 7 13 s7-7.75 7-13 c0-3.9-3.1-7-7-7 z M12 11.5 c-1.4 0-2.5-1.1-2.5-2.5 s1.1-2.5 2.5-2.5 2.5 1.1 2.5 2.5-1.1 2.5-2.5 2.5 z"
                            style="-fx-fill: transparent;
                                   -fx-stroke: #333333;
                                   -fx-stroke-width: 1.8;
                                   -fx-scale-x: 1.2;
                                   -fx-scale-y: 1.2;"/>

                    <ComboBox fx:id="toComboBox"
                              prefHeight="70"
                              prefWidth="325"
                              promptText="Kies aankomststation"
                              editable="true"
                              style="-fx-background-color: transparent; -fx-font-size: 16px;"/>
                </HBox>
            </VBox>
        </HBox>

        <VBox spacing="4">
            <Label fx:id="dateTimeLabel"
                   style="-fx-font-size: 22px; -fx-font-weight: bold;"
                   text="Datum en tijd"/>

            <HBox alignment="CENTER_LEFT" spacing="12">
                <DatePicker fx:id="datePicker"
                            prefWidth="190"
                            prefHeight="42"
                            style="-fx-font-size: 18px;"/>

                <HBox alignment="CENTER"
                      spacing="0"
                      prefHeight="42"
                      style="-fx-border-color: #B5B5B5;
                             -fx-border-width: 1;
                             -fx-background-color: white;
                             -fx-padding: 0 4 0 4;">

                    <Spinner fx:id="hourSpinner"
                             styleClass="time-spinner"
                             prefWidth="55"
                             prefHeight="34"
                             style="-fx-font-size: 18px;"/>

                    <Label text=":"
                           style="-fx-font-size: 18px;
                                  -fx-font-weight: bold;
                                  -fx-padding: 0 2 0 2;"/>

                    <Spinner fx:id="minuteSpinner"
                             styleClass="time-spinner"
                             prefWidth="55"
                             prefHeight="34"
                             style="-fx-font-size: 18px;"/>
                </HBox>
            </HBox>
        </VBox>

        <HBox alignment="CENTER">
            <Button fx:id="searchButton"
                    onAction="#searchTrip"
                    prefHeight="55"
                    prefWidth="215"
                    style="-fx-font-size: 20px;
                           -fx-font-weight: bold;
                           -fx-background-color: white;
                           -fx-border-color: #777;"
                    text="🔍  Zoek reis"/>
        </HBox>

        <Label fx:id="messageLabel"
               style="-fx-text-fill: red; -fx-font-size: 14px;"/>
    </VBox>
</VBox>
