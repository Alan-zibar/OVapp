<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER"
      spacing="20"
      style="-fx-padding: 30;"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="controller.LoginController">

    <VBox alignment="CENTER"
          spacing="18"
          prefWidth="650"
          maxWidth="650"
          style="-fx-border-color: #777;
                 -fx-border-width: 1.5;
                 -fx-padding: 35;
                 -fx-background-color: white;">

        <Label fx:id="loginTitleLabel"
               text="Inloggen"
               style="-fx-font-size: 30px; -fx-font-weight: bold;" />

        <Label fx:id="loginDescriptionLabel"
               text="Log in om je reizen, favorieten en instellingen te bewaren&#10;en meer mogelijkheden te gebruiken."
               textAlignment="CENTER"
               alignment="CENTER"
               wrapText="true"
               textOverrun="CLIP"
               minHeight="55"
               prefHeight="55"
               prefWidth="560"
               maxWidth="560"
               style="-fx-font-size: 15px;" />

        <VBox spacing="8"
              prefWidth="540"
              maxWidth="540">
            <Label fx:id="usernameLabel"
                   text="E-mailadres of gebruikersnaam"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <TextField fx:id="usernameField"
                       promptText="Voer je e-mailadres of gebruikersnaam in"
                       prefHeight="52"
                       prefWidth="540"
                       maxWidth="540"
                       style="-fx-font-size: 15px;" />
        </VBox>




        <VBox spacing="8"
              prefWidth="540"
              maxWidth="540">
            <Label fx:id="passwordLabel"
                   text="Wachtwoord"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <StackPane prefWidth="540"
                       maxWidth="540"
                       prefHeight="52">

                <PasswordField fx:id="passwordField"
                               promptText="Voer je wachtwoord in"
                               prefHeight="52"
                               prefWidth="540"
                               maxWidth="540"
                               style="-fx-font-size: 15px; -fx-padding: 0 50 0 12;" />

                <TextField fx:id="visiblePasswordField"
                           promptText="Voer je wachtwoord in"
                           prefHeight="52"
                           prefWidth="540"
                           maxWidth="540"
                           visible="false"
                           style="-fx-font-size: 15px; -fx-padding: 0 50 0 12;" />

                <Button fx:id="togglePasswordButton"
                        text="👁"
                        onAction="#togglePasswordVisibility"
                        prefWidth="45"
                        prefHeight="45"
                        style="-fx-background-color: transparent;
                       -fx-font-size: 16px;"
                        StackPane.alignment="CENTER_RIGHT" />
            </StackPane>
        </VBox>




        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               maxWidth="540"
               style="-fx-text-fill: red; -fx-font-size: 14px;" />

        <Button fx:id="loginFormButton"
                text="🔒  Inloggen"
                onAction="#handleLogin"
                prefWidth="540"
                maxWidth="540"
                prefHeight="52"
                style="-fx-background-color: black;
                       -fx-text-fill: white;
                       -fx-font-size: 17px;
                       -fx-font-weight: bold;" />

        <HBox alignment="CENTER"
              spacing="20"
              prefWidth="540"
              maxWidth="540">
            <Separator prefWidth="235" />
            <Label fx:id="orLabel"
                   text="of"
                   style="-fx-font-size: 15px;" />
            <Separator prefWidth="235" />
        </HBox>

        <Button fx:id="createAccountButton"
                onAction="#goToRegister"
                text="👥  Nieuw account aanmaken"
                prefWidth="540"
                maxWidth="540"
                prefHeight="45"
                style="-fx-background-color: white;
                       -fx-border-color: #777;
                       -fx-border-width: 1.3;
                       -fx-font-size: 15px;
                       -fx-font-weight: bold;" />
    </VBox>

    <Button fx:id="backHomeButton"
            text="←  Terug naar home"
            onAction="#goBackToHome"
            prefWidth="220"
            prefHeight="40"
            style="-fx-background-color: transparent;
                   -fx-font-size: 16px;" />
</VBox>