<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox alignment="CENTER"
      spacing="20"
      xmlns:fx="http://javafx.com/fxml/1"
      xmlns="http://javafx.com/javafx/17.0.12"
      fx:controller="controller.RegisterController">

    <VBox alignment="CENTER"
          spacing="16"
          prefWidth="580"
          maxWidth="580"
          style="-fx-border-color: #777;
                 -fx-border-width: 1.5;
                 -fx-padding: 25 35 25 35;
                 -fx-background-color: white;">

        <Label fx:id="registerTitleLabel"
               text="Account aanmaken"
               style="-fx-font-size: 26px; -fx-font-weight: bold;" />

        <VBox spacing="8" prefWidth="500">
            <Label fx:id="fullNameLabel"
                   text="Volledige naam"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <TextField fx:id="fullNameField"
                       promptText="Voer je volledige naam in:"
                       prefHeight="38"
                       style="-fx-font-size: 15px;" />
        </VBox>

        <VBox spacing="8" prefWidth="500">
            <Label fx:id="usernameLabel"
                   text="Gebruikersnaam:"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <TextField fx:id="usernameField"
                       promptText="Kies een gebruikersnaam:"
                       prefHeight="45"
                       style="-fx-font-size: 15px;" />
        </VBox>

        <VBox spacing="8" prefWidth="500">
            <Label fx:id="emailLabel"
                   text="E-mailadres:"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <TextField fx:id="emailField"
                       promptText="Voer je e-mailadres in:"
                       prefHeight="45"
                       style="-fx-font-size: 15px;" />
        </VBox>

        <VBox spacing="8" prefWidth="500">
            <Label fx:id="passwordLabel"
                   text="Wachtwoord:"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <PasswordField fx:id="passwordField"
                           promptText="Voer je wachtwoord in:"
                           prefHeight="45"
                           style="-fx-font-size: 15px;" />
        </VBox>

        <VBox spacing="8" prefWidth="500">
            <Label fx:id="confirmPasswordLabel"
                   text="Wachtwoord herhalen"
                   style="-fx-font-size: 15px; -fx-font-weight: bold;" />

            <PasswordField fx:id="confirmPasswordField"
                           promptText="Herhaal je wachtwoord:"
                           prefHeight="45"
                           style="-fx-font-size: 15px;" />
        </VBox>

        <Label fx:id="messageLabel"
               text=""
               wrapText="true"
               style="-fx-text-fill: red; -fx-font-size: 14px;" />

        <Button fx:id="createAccountButton"
                text="👥  Account aanmaken"
                onAction="#handleRegister"
                prefWidth="500"
                prefHeight="50"
                style="-fx-background-color: black;
                       -fx-text-fill: white;
                       -fx-font-size: 17px;
                       -fx-font-weight: bold;" />
    </VBox>
    <HBox alignment="CENTER" spacing="25">
        <Button fx:id="backToLoginButton"
                text="←  Terug naar inloggen"
                onAction="#goBackToLogin"
                prefWidth="230"
                prefHeight="38"
                style="-fx-background-color: transparent;
                   -fx-font-size: 15px;" />

        <Button fx:id="backHomeButton"
                text="←  Terug naar home"
                onAction="#goBackToHome"
                prefWidth="210"
                prefHeight="38"
                style="-fx-background-color: transparent;
                   -fx-font-size: 15px;" />
    </HBox>

</VBox>
