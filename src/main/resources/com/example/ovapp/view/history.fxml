<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="controller.HistoryController"
      alignment="TOP_CENTER"
      spacing="20"
      style="-fx-padding: 30; -fx-background-color: #f8f9fa;">

    <HBox alignment="CENTER_LEFT" spacing="20" style="-fx-fill-height: true;">
        <Label text="Reishistorie" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #1a1a1a;" />

        <Region HBox.hgrow="ALWAYS" />

        <Button fx:id="clearButton"
                text="Verwijder geschiedenis"
                onAction="#clearAllHistory"
                style="-fx-background-color: transparent; -fx-text-fill: #1a1a1a; -fx-font-size: 14px; -fx-cursor: hand; -fx-font-weight: bold; -fx-border-color: #1a1a1a; -fx-border-width: 1; -fx-border-radius: 4; -fx-padding: 5 10 5 10;" />
    </HBox>

    <ScrollPane fitToWidth="true"
                style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0; -fx-focused-background-color: transparent; -fx-box-border: transparent;">
        <VBox fx:id="historyContainer" spacing="12" style="-fx-background-color: transparent; -fx-padding: 5 2 5 2;" />
    </ScrollPane>

</VBox>